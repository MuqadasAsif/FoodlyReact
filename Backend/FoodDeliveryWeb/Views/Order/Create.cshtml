@model FoodDeliveryWeb.Models.Order

@{
    ViewData["Title"] = "Place Order";
}

<link rel="stylesheet" href="~/css/order-Create.css" />

<section class="order-page">

    <div class="order-container">

        <div class="order-header">
            <p class="eyebrow">FOODLY</p>

            <h1>
                Place Your Order
            </h1>
        </div>


        <div class="order-card">

            <div class="order-item">

                <h2>
                    @Model.ItemName
                </h2>

                <p class="order-price">
                    Rs. @ViewBag.Price
                </p>

            </div>


            <form asp-controller="Order"
                  asp-action="Create"
                  method="post"
                  class="order-form">

                <input type="hidden"
                       asp-for="RestaurantId" />

                <input type="hidden"
                       asp-for="ItemName" />

                <input type="hidden"
                       name="price"
                       value="@ViewBag.Price" />


                <div class="form-group">

                    <label>
                        Customer Name
                    </label>

                    <input asp-for="CustomerName"
                           placeholder="Enter your name"
                           required />

                </div>


                <div class="form-group">

                    <label>
                        Quantity
                    </label>

                    <input asp-for="Quantity"
                           type="number"
                           min="1"
                           value="1"
                           required />

                </div>


                <button type="submit"
                        class="place-order-btn">
                    Place Order
                </button>

            </form>


            <a asp-controller="Restaurant"
               asp-action="Index"
               class="back-link">
                ← Back to Restaurants
            </a>

        </div>

    </div>

</section>