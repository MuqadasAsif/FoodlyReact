@model List<FoodDeliveryWeb.Models.Restaurant>
@{
    ViewData["Title"] = "Foodly";
}

<link rel="stylesheet" href="~/css/restaurant.css" />

<header class="navbar">

    <div class="logo">
        Foodly
    </div>

    <nav>
        <a href="#" class="active">Home</a>

        <a asp-controller="Restaurant"
           asp-action="AllRestaurants">
            Restaurants
        </a>

        <a asp-controller="Order"
           asp-action="Index">
            Orders
        </a>
    </nav>

    <button class="cart-btn">
        Cart
    </button>

</header>


<!-- HERO -->

<section class="hero">

    <div class="hero-content">

        <p class="eyebrow">
            FRESH • FAST • DELICIOUS
        </p>

        <h1>
            Good food is
            <span>always</span>
            a good idea.
        </h1>

        <p class="hero-text">
            Discover your favorite restaurants and enjoy
            delicious meals delivered right to your doorstep.
        </p>


        <form asp-controller="Restaurant" 
              asp-action="Index"
              method="get"
              class="search-box">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search restaurants or dishes..." />

            <button type="submit">
                Search
            </button>

        </form>

    </div>


    <div class="hero-image">

        <img src="https://images.unsplash.com/photo-1579751626657-72bc17010498?auto=format&fit=crop&w=900&q=85"
             alt="Delicious food" />

    </div>

</section>


<!-- RESTAURANTS -->

<section class="restaurants">

    <div class="section-header">

        <div>
            <p class="eyebrow">
                DISCOVER
            </p>

            <h2>
                Popular restaurants
            </h2>

        </div>

        <a asp-controller="Restaurant"
           asp-action="AllRestaurants">
            View all →
        </a>

    </div>


    <div class="restaurant-grid">

        @foreach (var restaurant in Model)
        {
            <div class="restaurant-card">

                <div class="food-image">

                    <!-- Database se image -->
                    <img src="@restaurant.ImageUrl"
                         alt="@restaurant.Name" />

                    <!-- Database se rating -->
                    <span class="rating">
                        ⭐ @restaurant.Rating
                    </span>

                </div>

                <div class="card-content">

                    <h3>
                        @restaurant.Name
                    </h3>

                    <p>
                        @restaurant.Address
                    </p>

                    <div class="card-bottom">

                        <span>
                            @(restaurant.IsOpen ? "Open now" : "Closed")
                        </span>

                        <a asp-controller="Restaurant"
                           asp-action="Menu"
                           asp-route-id="@restaurant.Id"
                           class="view-btn">
                            View
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>


<!-- FOOTER -->

<footer>

    <div class="footer-logo">
        Foodly
    </div>

    <p>
        Delicious food, delivered to your door.
    </p>

</footer>