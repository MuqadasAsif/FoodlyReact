
@model FoodDeliveryWeb.Models.RestaurantMenuViewModel

@{
    ViewData["Title"] = Model.Restaurant.Name + " Menu";
}

<link rel="stylesheet" href="~/css/restaurant.css" asp-append-version="true" />

<section class="restaurants">

    <div class="section-header">

        <div>
            <p class="eyebrow">
                @Model.Restaurant.Name
            </p>

            <h2>
                Menu
            </h2>

            <p>
                @Model.Restaurant.Address
            </p>
        </div>

        <a asp-controller="Restaurant"
           asp-action="Index">
            ← Back
        </a>

    </div>

    @foreach (var menu in Model.Menus)
    {
        <div class="restaurant-card">

            <div class="card-content">

                <h3>
                    @menu.Name
                </h3>

                <p>
                    @menu.Description
                </p>

                <p>
                    Rs. @menu.Price
                </p>

                <a asp-controller="Order"
                   asp-action="Create"
                   asp-route-restaurantId="@Model.Restaurant.Id"
                   asp-route-itemName="@menu.Name"
                   asp-route-price="@menu.Price"
                   class="menu-order-button">
                    Order Now
                </a>

            </div>

        </div>
    }

</section>
